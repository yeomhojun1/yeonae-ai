# --- 데이터베이스 (PostgreSQL) ---
# 로컬 Postgres 예시:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/yeonae?schema=public"
# Neon(무료 클라우드) 예시:
#   DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/yeonae?sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/yeonae?schema=public"

# --- Claude API 키 ---
# https://console.anthropic.com 에서 발급.
# 비워두면 앱은 "목업(mock) 분석 결과"로 동작해서 키 없이도 화면을 확인할 수 있습니다.
ANTHROPIC_API_KEY=""

# --- Auth.js (NextAuth) ---
# 세션 암호화용 시크릿. 아래 명령으로 생성:  npx auth secret
AUTH_SECRET=""

# 카카오 로그인 (https://developers.kakao.com 에서 앱 생성 후 발급)
# - REST API 키를 AUTH_KAKAO_ID 에 입력
# - 보안 > Client Secret 을 발급해 AUTH_KAKAO_SECRET 에 입력
# - 카카오 로그인 > Redirect URI 에 아래 주소 등록:
#     로컬:  http://localhost:3000/api/auth/callback/kakao
#     배포:  https://<your-domain>/api/auth/callback/kakao
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# 배포 환경(Vercel 이외)에서 프록시 뒤에 있을 때 필요할 수 있음
# AUTH_TRUST_HOST=true
