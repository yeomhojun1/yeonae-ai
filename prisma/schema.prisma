// 연애 대화 분석 AI — 데이터베이스 스키마
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Auth.js (NextAuth) 표준 모델 =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // 이메일/비밀번호 회원가입용 bcrypt 해시. 소셜 로그인(카카오 등) 사용자는 null.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  // RAG 재인덱싱 남용 방지용 쿨다운 기준 시각
  lastReindexAt DateTime?

  accounts         Account[]
  sessions         Session[]
  analysisSessions AnalysisSession[]
  dailyUsages      DailyUsage[]
}

// 하루 무료 분석 횟수를 원자적으로 세는 카운터.
// 분석 세션 수를 세는 방식은 (count → Claude 호출 → create) 사이에 원자성이 없어
// 동시 요청 시 한도를 넘겨 Claude가 여러 번 과금될 수 있었다.
// 이 카운터를 Claude 호출 "전에" upsert-increment 로 선점해 동시요청 과금을 막는다.
model DailyUsage {
  id     String @id @default(cuid())
  userId String
  day    String // "YYYY-MM-DD" (Asia/Seoul 기준)
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== 서비스 도메인 모델 =====

model AnalysisSession {
  id         String   @id @default(cuid())
  userId     String
  title      String
  rawText    String   @db.Text
  // Claude 분석 결과 전체를 JSON으로 저장
  resultJson Json
  // 대화 흐름/호감도 점수 (0~100)
  score      Int
  createdAt  DateTime @default(now())

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replySuggestions ReplySuggestion[]
  chunks           ConversationChunk[]

  @@index([userId])
  @@index([createdAt])
}

// ===== [마일스톤1: 청킹·임베딩·저장] — 저장할 데이터 모델 =====
// 대화를 조각(청킹)내고 각 조각의 의미 임베딩(벡터)을 저장하는 테이블.
// embedding(Float[]) = 마일스톤1의 학습용 저장 / embedding_vec(vector) = 마일스톤5의 pgvector 저장.
model ConversationChunk {
  id        String   @id @default(cuid())
  sessionId String
  userId    String // 검색을 사용자 범위로 좁히기 위해 중복 저장
  index     Int // 원본 대화에서 조각의 순서
  text      String   @db.Text // 조각 원문 (LLM에 근거로 넣을 실제 텍스트)
  embedding Float[] // 의미 좌표 (multilingual-e5-small = 384차원) — 학습용 JS 코사인
  // pgvector 컬럼 — raw SQL로 관리(Prisma는 vector 타입 미지원). db push가 삭제하지 않도록 선언만.
  embeddingVec Unsupported("vector(384)")? @map("embedding_vec")
  createdAt DateTime @default(now())

  session AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model ReplySuggestion {
  id        String   @id @default(cuid())
  sessionId String
  tone      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  session AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
