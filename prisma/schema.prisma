// 연애 대화 분석 AI — 데이터베이스 스키마
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Auth.js (NextAuth) 표준 모델 =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  analysisSessions AnalysisSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== 서비스 도메인 모델 =====

model AnalysisSession {
  id         String   @id @default(cuid())
  userId     String
  title      String
  rawText    String   @db.Text
  // Claude 분석 결과 전체를 JSON으로 저장
  resultJson Json
  // 대화 흐름/호감도 점수 (0~100)
  score      Int
  createdAt  DateTime @default(now())

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replySuggestions ReplySuggestion[]
  chunks           ConversationChunk[]

  @@index([userId])
  @@index([createdAt])
}

// RAG용: 대화를 조각(청킹)내고 각 조각의 의미 임베딩(벡터)을 저장.
// 학습용 심플 버전 — 임베딩을 Float[]로 저장하고 코사인 유사도는 JS에서 계산.
// (프로덕션에선 pgvector로 업그레이드 예정)
model ConversationChunk {
  id        String   @id @default(cuid())
  sessionId String
  userId    String // 검색을 사용자 범위로 좁히기 위해 중복 저장
  index     Int // 원본 대화에서 조각의 순서
  text      String   @db.Text // 조각 원문 (LLM에 근거로 넣을 실제 텍스트)
  embedding Float[] // 의미 좌표 (multilingual-e5-small = 384차원)
  createdAt DateTime @default(now())

  session AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model ReplySuggestion {
  id        String   @id @default(cuid())
  sessionId String
  tone      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  session AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
